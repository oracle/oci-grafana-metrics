# OCI Metrics Plugin - Dev Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env

# Required: Your OCI compartment OCID for test dashboard queries
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..REPLACE_WITH_YOUR_COMPARTMENT_OCID

# Required: OCI regions for the two test dashboard panels
OCI_REGION_1=us-ashburn-1
OCI_REGION_2=us-phoenix-1

# Optional: OCI namespace and metric for test panels (defaults shown)
OCI_NAMESPACE=oci_lbaas
OCI_METRIC=PeakBandwidth

# Optional: OCI compute instance hostname for SSH tunnel (Instance Principal auth).
# Used with: ./test.sh --tunnel
SSH_TUNNEL_HOST=
